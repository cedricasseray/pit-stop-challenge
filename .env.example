# A copier en ".env" pour tester en local (netlify dev). NE JAMAIS publier le vrai .env.
# En production : Netlify > Site configuration > Environment variables.

# Code à 3 chiffres du cadenas (à changer ici, sans toucher au code)
PADDOCK_CODE=123

# Secret long et aléatoire pour signer les sessions (>= 16 caractères)
TOKEN_SECRET=remplacez-par-une-longue-phrase-aleatoire-0123456789

# URL du webhook Make (optionnel au début)
MAKE_WEBHOOK_URL=
